# SwiftFormat config for Photonic iOS/macOS app
# Run: swiftformat .           (auto-fix)
#      swiftformat --lint .    (CI check)

--swiftversion 5.10

# Paths to skip (generated code and build artefacts)
--exclude Photonic/Infrastructure/API/Generated
--exclude PhotonicClient
--exclude **/.build
--exclude **/DerivedData
--exclude **/Pods

# Indentation / width
--indent 4
--tabwidth 4
--maxwidth 140

# Keep `{` on the same line as `if` / `guard` / `func` — matches Apple's
# style guide and SwiftLint's `opening_brace` rule. Without this, the two
# tools fight each other on multi-line conditions.
--disable wrapMultilineStatementBraces

# Argument wrapping: when wrapping is needed, wrap before the first argument.
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--closingparen balanced

# Misc preferences
--commas inline
--semicolons never
--trimwhitespace always
--ifdef no-indent
--self remove
--importgrouping testable-bottom
--stripunusedargs closure-only
--header ignore
--emptybraces no-space